---
import Seo from "./Seo.astro"
import "../../styles/global.css"

const {
  title,
  metaTitle,
  description,
  canonical = Astro.url.pathname,
  noindex = false,
  image = "/og-image.jpg",
  twitterUsername = "@yourhandle",
  additionalMeta = [],
  additionalLink = [],
} = Astro.props
---

<html lang="en">
  <head>
    <Seo
      title={metaTitle || title}
      description={description}
      canonical={canonical}
      noindex={noindex}
      image={image}
      twitterUsername={twitterUsername}
      additionalMeta={additionalMeta}
      additionalLink={additionalLink}
    />
  </head>

  <body class="min-h-screen flex flex-col overflow-hidden">
    <header
      class="bg-white/60 backdrop-blur-lg h-16 fixed top-0 w-full z-[10000] flex justify-center items-center"
    >
      <nav class="w-full flex flex-row justify-between items-center p-5">
        <a href="/" class="text-xl font-serif text-gray-600 w-max min-w-max">
          <h1 class="leading-5">
            eternal concepts<br />
            <span class="font-serif font-light italic text-stone-400 text-sm"
              >by Philip J. Rhea</span
            >
          </h1>
        </a>

        <!-- Off-canvas by default on mobile, normal on lg+ -->
        <ul
          class="fixed w-1/2 lg:w-max top-16 right-0 z-50 lg:static lg:translate-x-0 lg:flex duration-500 gap-4 delay-75 ease-in-out"
          id="menuLinks"
        >
          <li>
            <a href="/contact" class="hover:underline block px-4 py-2"
              >Profile</a
            >
          </li>
          <li>
            <a href="/about" class="hover:underline block px-4 py-2"
              >Philosophy</a
            >
          </li>
          <li>
            <a href="/portfolio" class="hover:underline block px-4 py-2"
              >Portfolio</a
            >
          </li>
          <li>
            <a href="/parley" class="hover:underline block px-4 py-2">Parley</a>
          </li>
          <li>
            <a href="/proposal" class="hover:underline block px-4 py-2"
              >Proposal</a
            >
          </li>
          <li>
            <a href="/portal" class="hover:underline block px-4 py-2">Portal</a>
          </li>
        </ul>

        <button
          class="relative aspect-square duration-200 lg:hidden size-8 burger border border-stone-300 overflow-hidden"
          data-state="init"
          onclick="burgerMenu(this)"
        >
          <span class="line-1"></span>
          <span class="line-2"></span>
          <span class="line-3"></span>
        </button>
      </nav>
    </header>

    <main
      class="w-screen overflow-hidden h-full min-h-[calc(100vh-8rem)] bg-stone-200"
    >
      <div
        id="pageContent"
        class="duration-500 ease-[cubic-bezier(1,-0.13,.17,1.18)] h-screen pt-16 overflow-auto relative origin-top-left bg-white"
      >
        <slot />
        <footer
          class="bg-gray-800 text-white text-center p-4 w-full h-16 text-sm"
        >
          &copy; {new Date().getFullYear()} Eternal Concepts by Philip J. Rhea.<br
          />All rights reserved.
        </footer>
      </div>
    </main>

    <script is:inline>
      function burgerMenu(button) {
        // 1) flip the state
        const state = button.getAttribute("data-state")
        const next = state === "on" ? "off" : "on"
        button.setAttribute("data-state", next)

        // 2) toggle button colors
        // button.classList.remove("bg-green-500")
        // button.classList.toggle("bg-blue-500", next === "off")
        // button.classList.toggle("bg-red-500", next === "on")

        // 3) transform page content
        const main = document.getElementById("pageContent")
        const closedMenu = [
          "scale-[100%]",
          "translate-x-[0%]",
          "translate-y-[0%]",
          "w-screen",
          "overflow-auto",
        ]
        const openMenu = [
          "scale-[50%]",
          "overflow-hidden",
          "w-screen",
          "border",
          "border-stone-300",
          "shadow-xl",
          "rounded-2xl",
          "-translate-x-[20%]",
          "translate-y-[25%]",
        ]
        if (next === "on") {
          main.classList.remove(...closedMenu)
          main.classList.add(...openMenu)
        } else {
          main.classList.remove(...openMenu)
          main.classList.add(...closedMenu)
          setTimeout(() => main.classList.remove("w-screen"), 300)
        }

        // 4) slide the links in/out
        const links = document.getElementById("menuLinks")
        if (next === "on") {
          // bring on-screen
          links.classList.remove("translate-x-full")
          links.classList.add("translate-x-0")
        } else {
          // push off-screen
          links.classList.remove("translate-x-0")
          links.classList.add("translate-x-full")
        }

        // 5) re-trigger stagger animation if you use it
        if (next === "on") {
          links.classList.remove("links-open")
          void links.offsetWidth
          links.classList.add("links-open")
        } else {
          links.classList.remove("links-open")
        }
      }
    </script>
  </body>
</html>
