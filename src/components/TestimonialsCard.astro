---
const { referralText, referralPerson } = Astro.props
const classDl = Astro.props["class"]
---

<blockquote
  class={"p-7 m-auto h-full max-w-[24rem] aspect-square relative group duration-500 ease-in-out group " +
    classDl}
>
  <div
    class="relative w-full h-full aspect-square px-5 overflow-auto scrollbar-p-2 scrollbar-thumb-rounded-full scrollbar-thin scrollbar-thumb-rose-600 md:scrollbar-track-transparent md:scrollbar-thumb-rose-600/0 lg:group-hover:scrollbar-thumb-rose-600 duration-200 border rounded-2xl border-stone-400 group-hover:border-b-8 group-hover:-translate-y-1"
  >
    <div
      class="sticky top-0 left-0 w-full h-5 bg-gradient-to-b from-white from-50% to-transparent"
    >
    </div>

    <p>
      {referralText}
    </p>
    <div
      class="sticky bottom-0 left-0 w-full h-5 bg-gradient-to-t from-white from-20% to-transparent"
    >
    </div>
  </div>
  {
    referralPerson && (
      <p class="h-10 px-4 text-sm md:text-base font-trajan rounded-2xl absolute top-0 left-[50%] translate-x-[-50%] bg-white border border-stone-300 group-hover:text-rose-700 duration-300 ease-in-out truncate flex justify-center items-center">
        {referralPerson}
      </p>
    )
  }
  <svg
    class="fill-stone-400 group-hover:fill-rose-700 size-12 lg:size-14 absolute top-0 left-0 bg-white p-3 rounded-2xl duration-300 ease-in-out"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 32 32"
  >
    <path
      d="M7.031 14c3.866 0 7 3.134 7 7s-3.134 7-7 7-7-3.134-7-7l-0.031-1c0-7.732 6.268-14 14-14v4c-2.671 0-5.182 1.040-7.071 2.929-0.364 0.364-0.695 0.751-0.995 1.157 0.357-0.056 0.724-0.086 1.097-0.086zM25.031 14c3.866 0 7 3.134 7 7s-3.134 7-7 7-7-3.134-7-7l-0.031-1c0-7.732 6.268-14 14-14v4c-2.671 0-5.182 1.040-7.071 2.929-0.364 0.364-0.695 0.751-0.995 1.157 0.358-0.056 0.724-0.086 1.097-0.086z"
    ></path>
  </svg>
  <svg
    class="fill-stone-400 group-hover:fill-rose-700 size-12 lg:size-14 absolute bottom-0 right-0 rotate-180 bg-white p-3 rounded-2xl duration-300 ease-in-out"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 32 32"
  >
    <path
      d="M7.031 14c3.866 0 7 3.134 7 7s-3.134 7-7 7-7-3.134-7-7l-0.031-1c0-7.732 6.268-14 14-14v4c-2.671 0-5.182 1.040-7.071 2.929-0.364 0.364-0.695 0.751-0.995 1.157 0.357-0.056 0.724-0.086 1.097-0.086zM25.031 14c3.866 0 7 3.134 7 7s-3.134 7-7 7-7-3.134-7-7l-0.031-1c0-7.732 6.268-14 14-14v4c-2.671 0-5.182 1.040-7.071 2.929-0.364 0.364-0.695 0.751-0.995 1.157 0.358-0.056 0.724-0.086 1.097-0.086z"
    ></path>
  </svg>
</blockquote>
