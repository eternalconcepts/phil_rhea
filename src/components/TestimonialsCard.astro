---
const { referralText, referralPerson } = Astro.props
---

<blockquote
  class="my-5 p-8 border w-10/12 max-w-[24rem] aspect-square text-lg relative rounded-2xl border-stone-300 hover:border-b-8 hover:-translate-y-1 group duration-500 ease-in-out group"
>
  <p
    class="h-10 px-4 text-sm md:text-base font-trajan rounded-2xl absolute -top-6 left-[50%] translate-x-[-50%] bg-white border border-stone-300 group-hover:text-rose-700 duration-300 ease-in-out truncate flex justify-center items-center"
  >
    {referralPerson}
  </p>
  <svg
    class="fill-stone-400 group-hover:fill-rose-700 size-14 absolute -top-4 -left-6 bg-white p-3 rounded-2xl duration-300 ease-in-out"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 32 32"
  >
    <path
      d="M7.031 14c3.866 0 7 3.134 7 7s-3.134 7-7 7-7-3.134-7-7l-0.031-1c0-7.732 6.268-14 14-14v4c-2.671 0-5.182 1.040-7.071 2.929-0.364 0.364-0.695 0.751-0.995 1.157 0.357-0.056 0.724-0.086 1.097-0.086zM25.031 14c3.866 0 7 3.134 7 7s-3.134 7-7 7-7-3.134-7-7l-0.031-1c0-7.732 6.268-14 14-14v4c-2.671 0-5.182 1.040-7.071 2.929-0.364 0.364-0.695 0.751-0.995 1.157 0.358-0.056 0.724-0.086 1.097-0.086z"
    ></path>
  </svg>
  <svg
    class="fill-stone-400 group-hover:fill-rose-700 size-14 absolute -bottom-4 -right-6 rotate-180 bg-white p-3 rounded-2xl duration-300 ease-in-out"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 32 32"
  >
    <path
      d="M7.031 14c3.866 0 7 3.134 7 7s-3.134 7-7 7-7-3.134-7-7l-0.031-1c0-7.732 6.268-14 14-14v4c-2.671 0-5.182 1.040-7.071 2.929-0.364 0.364-0.695 0.751-0.995 1.157 0.357-0.056 0.724-0.086 1.097-0.086zM25.031 14c3.866 0 7 3.134 7 7s-3.134 7-7 7-7-3.134-7-7l-0.031-1c0-7.732 6.268-14 14-14v4c-2.671 0-5.182 1.040-7.071 2.929-0.364 0.364-0.695 0.751-0.995 1.157 0.358-0.056 0.724-0.086 1.097-0.086z"
    ></path>
  </svg>
  <p
    class="w-full h-full aspect-square overflow-auto scrollbar-thin scrollbar-track-transparent scrollbar-thumb-rose-600/0 lg:group-hover:scrollbar-thumb-rose-600 duration-200"
  >
    {referralText}
  </p>
</blockquote>
