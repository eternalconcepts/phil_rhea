---
import { caseStudyPath } from "../../lib/server/case-studies"
import { portfolioProjectPath } from "../../lib/server/portfolio"

const { project } = Astro.props
const href = project.type === "case-study" ? caseStudyPath(project.slug) : portfolioProjectPath(project.slug)
const cardLabel = project.type === "case-study" ? "Case study" : "Project"
const ctaLabel = project.type === "case-study" ? "View case study" : "View project"
---

<a href={href} class="group grid grid-rows-[auto_auto_1fr_auto]" aria-label={`View ${project.title}`}>
  <div class="relative overflow-hidden rounded-[1.75rem] border border-stone-300/80 bg-stone-200 shadow-sm transition duration-500 group-hover:-translate-y-1 group-hover:shadow-xl">
    <div class="absolute inset-x-0 top-0 z-10 flex items-center justify-between p-4 text-[0.68rem] uppercase tracking-[0.28em] text-white">
      <span class="rounded-full border border-white/25 bg-stone-950/45 px-3 py-1 backdrop-blur-sm">{cardLabel}</span>
      {project.size ? <span class="rounded-full border border-white/20 bg-white/10 px-3 py-1 backdrop-blur-sm">{project.size}</span> : null}
    </div>
    {
      project.thumbnail ? (
        <img
          src={project.thumbnail.url}
          alt={project.thumbnail.alt}
          loading="lazy"
          class="aspect-[4/3] w-full object-cover transition duration-700 ease-in-out group-hover:scale-[1.05] lg:aspect-square"
        />
      ) : (
        <div class="grid aspect-[4/3] place-items-center bg-stone-100 text-center text-sm text-stone-500 lg:aspect-square">
          Image coming soon
        </div>
      )
    }
    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-stone-950/55 via-stone-950/10 to-transparent opacity-70 transition duration-500 group-hover:opacity-100"></div>
  </div>

  <h2 class="pt-5 text-xl leading-tight lg:text-2xl">{project.title}</h2>

  <div class="mt-3 flex h-full flex-col gap-3 text-stone-600">
    {project.address ? <p class="font-serif text-base italic text-stone-500">{project.address}</p> : null}
    <p class="leading-7 text-stone-600">{project.shortDescription || "Detailed project information available on the full case study page."}</p>
  </div>

  <span class="mt-5 inline-flex items-center gap-2 text-sm uppercase tracking-[0.25em] text-stone-500 transition group-hover:text-stone-900">
    {ctaLabel}
    <span aria-hidden="true">-></span>
  </span>
</a>
