---
import Youtube from "./Youtube.astro"

const { videos = [], images = [], projectTitle = "Project" } = Astro.props

function getYouTubeId(url) {
  try {
    const parsed = new URL(url)

    if (parsed.hostname.includes("youtu.be")) {
      return parsed.pathname.replace(/^\//, "")
    }

    if (parsed.hostname.includes("youtube.com")) {
      if (parsed.pathname === "/watch") {
        return parsed.searchParams.get("v")
      }

      if (parsed.pathname.startsWith("/embed/")) {
        return parsed.pathname.split("/embed/")[1]
      }

      if (parsed.pathname.startsWith("/shorts/")) {
        return parsed.pathname.split("/shorts/")[1]
      }
    }
  } catch {
    return null
  }

  return null
}
---

<section class="space-y-8">
  {
    videos.length > 0 ? (
      <div class="grid gap-5">
        {
          videos.map((video, index) => {
            const youtubeId = getYouTubeId(video.url)
            const title = video.title || `${projectTitle} video ${index + 1}`

            return youtubeId ? (
              <div class="overflow-hidden rounded-[1.75rem] bg-stone-100 shadow-[0_20px_45px_rgba(28,25,23,0.12)]">
                <Youtube videoId={youtubeId} alt={title} index={index} />
              </div>
            ) : (
              <a
                href={video.url}
                target="_blank"
                rel="noreferrer"
                class="flex aspect-video items-center justify-center rounded-[1.75rem] border border-stone-300 bg-stone-100 p-6 text-center text-sm uppercase tracking-[0.2em] text-stone-600 shadow-[0_20px_45px_rgba(28,25,23,0.12)]"
              >
                Open video
              </a>
            )
          })
        }
      </div>
    ) : null
  }

  {
    images.length > 0 ? (
      <div class="portfolio-masonry">
        {
          images.map((image, index) => (
            <a
              href={image.largeUrl}
              target="_blank"
              rel="noreferrer"
              class:list={[
                "portfolio-masonry__item group block overflow-hidden",
                index % 5 === 0 ? "portfolio-masonry__item--featured" : "",
              ]}
              data-masonry-reveal
            >
              <img
                src={image.url}
                width={image.width}
                height={image.height}
                alt={image.alt}
                srcset={image.srcSet || undefined}
                sizes="(min-width: 1280px) 31vw, (min-width: 768px) 50vw, 100vw"
                loading={index < 2 ? "eager" : "lazy"}
                decoding="async"
                class="portfolio-masonry__image transition duration-500 ease-out group-hover:scale-[1.02]"
              />
            </a>
          ))
        }
      </div>
    ) : null
  }
</section>

<script type="module">
  const masonryRevealItems = Array.from(
    document.querySelectorAll("[data-masonry-reveal]"),
  )

  const masonryRevealObservers = []

  function disconnectMasonryRevealObservers() {
    masonryRevealObservers.forEach((observer) => observer.disconnect())
    masonryRevealObservers.length = 0
  }

  function syncMasonryRevealObservers() {
    disconnectMasonryRevealObservers()

    masonryRevealItems.forEach((item) => {
      if (!item.dataset.fadeDuration) {
        item.dataset.fadeDuration = String(1000 + Math.round(Math.random() * 1000))
      }

      const fadeDuration = Number(item.dataset.fadeDuration || "1400")
      const rect = item.getBoundingClientRect()

      item.style.setProperty("--masonry-fade-duration", `${fadeDuration}ms`)
      item.style.setProperty(
        "--masonry-rise-duration",
        `${Math.min(fadeDuration + 180, 2200)}ms`,
      )

      if (rect.top <= window.innerHeight) {
        item.dataset.visible = "true"
        return
      }

      item.dataset.visible = "false"

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.boundingClientRect.top > window.innerHeight) return
            item.dataset.visible = "true"
            observer.disconnect()
          })
        },
        {
          threshold: 0,
          rootMargin: "0px 0px 0px 0px",
        },
      )

      observer.observe(item)
      masonryRevealObservers.push(observer)
    })
  }

  if (masonryRevealItems.length > 0) {
    syncMasonryRevealObservers()
    window.addEventListener("beforeunload", disconnectMasonryRevealObservers)
  }
</script>

<style>
  .portfolio-masonry {
    column-count: 1;
    column-gap: 1rem;
  }

  .portfolio-masonry__item {
    break-inside: avoid;
    margin-bottom: 1rem;
    border-radius: 1.5rem;
    background: rgb(245 245 244);
    box-shadow: 0 18px 40px rgba(28, 25, 23, 0.12);
    opacity: 0;
    transform: translateY(22px);
    transition:
      opacity var(--masonry-fade-duration, 1400ms) ease,
      transform var(--masonry-rise-duration, 1600ms)
        cubic-bezier(0.22, 1, 0.36, 1);
  }

  .portfolio-masonry__item--featured {
    border-radius: 2rem;
  }

  .portfolio-masonry__item[data-visible="true"] {
    opacity: 1;
    transform: translateY(0);
  }

  .portfolio-masonry__image {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  @media (min-width: 768px) {
    .portfolio-masonry {
      column-count: 2;
    }
  }

  @media (min-width: 1280px) {
    .portfolio-masonry {
      column-count: 3;
    }
  }
</style>
