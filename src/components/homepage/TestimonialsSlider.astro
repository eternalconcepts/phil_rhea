---
import TestimonialsCard from "../TestimonialsCard.astro"
import fetchApi from "../../lib/strapi"

const { data: page, error } = await fetchApi({
  endpoint: "home-page",
  query: {
    Testimonials: "",
    populate: "*",
  },
})

if (error) {
  console.error("Strapi error:", error)
}

const testimonials = page?.Testimonials || []

const items = testimonials.map((t) => ({
  referralText: t.referral_text || "",
  referralPerson: t.referral_person || "",
}))

console.log("page", page.Testimonials)
---

<section class="flex flex-row gap-5 items-center justify-center py-10">
  <!-- <h2 class="text-2xl font-semibold">Testimonials</h2>
  <p class="mt-2">description about testimonials</p> -->

  {
    items.map(({ referralText, referralPerson }, i) => (
      <TestimonialsCard
        key={i}
        referralText={referralText}
        referralPerson={referralPerson}
      />
    ))
  }
</section>
