---
import { buildStrapiSrcSet, pickStrapiImageSource, toAbsoluteStrapiUrl } from "../../lib/strapi-media"

const { homePage } = Astro.props

const images = [homePage?.bioImgMain, homePage?.bioImgSecond]
  .filter(Boolean)
  .map((img) => ({
    id: img.id,
    width: img.width,
    height: img.height,
    alt: img.alternativeText || img.name || "Phil Rhea",
    src: pickStrapiImageSource(img, { targetWidth: 1200 })?.url || toAbsoluteStrapiUrl(img.url),
    srcSet: buildStrapiSrcSet(img),
  }))
---

<section
  class="overflow-x-hidden min-h-screen border-y-2 border-stone-200 flex flex-col xl:flex-row items-center justify-center px-5 py-10 relative bg-stone-50"
>
  <div
    class="absolute top-0 left-0 w-full h-20 bg-gradient-to-b from-stone-100 to-transparent"
  >
  </div>


  <div class="relative w-11/12 max-w-[700px]">
    {/* background frames */}
    <div
      class="absolute top-0 left-0 w-full border aspect-square -rotate-6 border-stone-200 -z-0 rounded-xl"
    >
    </div>
    <div
      class="absolute top-0 left-0 w-full border aspect-square -rotate-3 border-stone-300 -z-0 rounded-xl"
    >
    </div>
    <div
      class="absolute top-0 left-0 w-full border aspect-square -rotate-1 border-stone-400 -z-0 rounded-xl"
    >
    </div>

    {
      images.map((image, i) => {
        const cls =
          i === 0
            ? "w-full h-full max-w-[800px] object-cover rounded-xl aspect-square"
            : "hidden xl:flex absolute max-w-[200px] 2xl:max-w-[300px] object-cover rounded-xl xl:-bottom-[10%] xl:-left-[10%] shadow-2xl aspect-square"

        return (
          <img
            key={image.id}
            src={image.src}
            width={image.width}
            height={image.height}
            srcset={image.srcSet || undefined}
            sizes={i === 0 ? "(min-width: 1280px) 700px, (min-width: 768px) 80vw, 100vw" : "(min-width: 1536px) 300px, 200px"}
            loading="lazy"
            decoding="async"
            alt={i === 0 ? image.alt || "Phil Rhea" : image.alt || "Phil Rhea at work"}
            class={cls}
          />
        )
      })
    }
  </div>

  <div class="w-full max-w-[700px] leading-loose mt-10 xl:mt-0">
    <p class="text-xl flex items-center">
      <span
        class="font-pacioli text-5xl text-rose-600 translate-x-5"
        aria-label="Philip">p</span
      >
    </p>
    <p class="indent-18 -translate-y-8 px-2 lg:px-8">
      <span
        class="font-trajan text-2xl text-rose-600 -ml-2 lg:-ml-8"
        aria-label="J. Rhea">hilip J. Rhea</span
      >
      {homePage?.Biography}
    </p>
  </div>
</section>
