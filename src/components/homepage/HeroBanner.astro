---
import image01 from "../../images/sta_02.jpg"
import image02 from "../../images/civ_01.jpg"
import image03 from "../../images/res_07.jpg"
import { buildStrapiSrcSet, pickStrapiImageSource, toAbsoluteStrapiUrl } from "../../lib/strapi-media"
import PJRLogoEmblem from "../icons/PJRLogoEmblem.astro"

const { homePage } = Astro.props

const hexToRgba = (hex, a) => {
  const r = parseInt(hex.slice(1, 3), 16)
  const g = parseInt(hex.slice(3, 5), 16)
  const b = parseInt(hex.slice(5, 7), 16)

  return `rgba(${r}, ${g}, ${b}, ${a})`
}

const title = homePage?.herobanner?.title || "Eternal Concepts"
const description =
  homePage?.herobanner?.description ||
  "Welcome to Eternal Concepts, where we bring your architectural visions to life. Traditional craftsmanship meets modern design. Design, remodel, and elevate your spaces with us."
const fallbackImages = [
  {
    color: "#d97706",
    url: image01.src,
    width: image01.width,
    height: image01.height,
    formats: {},
  },
  {
    color: "#b45309",
    url: image02.src,
    width: image02.width,
    height: image02.height,
    formats: {},
  },
  {
    color: "#92400e",
    url: image03.src,
    width: image03.width,
    height: image03.height,
    formats: {},
  },
]
const imagesData = homePage?.herobanner?.heroSlides || []

const images = imagesData.map((img) => ({
  color: img.slide_color,
  width: img.slide_image?.width,
  height: img.slide_image?.height,
  url:
    pickStrapiImageSource(img.slide_image, { targetWidth: 1600, allowOriginal: false })?.url ||
    toAbsoluteStrapiUrl(img.slide_image?.url),
  srcSet: buildStrapiSrcSet(img.slide_image),
}))
const slides = images.length > 0 ? images : fallbackImages
---

<div
  class="w-full lg:max-h-[50vh] lg:min-h-[25rem] relative overflow-hidden flex flex-col gap-5 lg:gap-0"
>
  <div
    class="relative aspect-square sm:aspect-video w-full h-full object-cover overflow-hidden"
  >
    {
      slides.map((image, i) => {
        return (
          <img
            src={image.url}
            width={image.width}
            height={image.height}
            srcset={image.srcSet || undefined}
            sizes="100vw"
            alt={`Hero image ${i + 1}`}
            loading={i === 0 ? "eager" : "lazy"}
            decoding={i === 0 ? "sync" : "async"}
            fetchpriority={i === 0 ? "high" : "low"}
            class={` absolute top-0 right-0 w-full h-full aspect-square sm:aspect-video lg:w-3/4 object-cover transition-opacity duration-1000 ease-in-out ${
              i === 0 ? "opacity-100 z-1" : "opacity-0"
            }`}
            data-hero
          />
        )
      })
    }
    <div
      style=""
      class="hidden lg:block lg:absolute top-0 right-0 w-full h-full lg:w-3/4 z-10 bg-gradient-to-r from-white to-transparent to-30%"
    >
    </div>
    {
      slides.map((image, i) => (
        <div
          class={`hidden lg:block lg:absolute inset-0 w-full h-full lg:w-3/4 bg-gradient-to-r from-35% to-transparent transition-opacity duration-1000 ease-in-out ${
            i === 0 ? "opacity-100 z-30" : " opacity-0 z-20 "
          }`}
          data-hero-bg
          data-color={hexToRgba(image.color, 1)}
          style={{
            "--tw-gradient-from": hexToRgba(image.color, 1),
            "--tw-gradient-via": hexToRgba(image.color, 0.7),
          }}
        />
      ))
    }
  </div>

  <div
    class="px-5 lg:px-0 lg:absolute inset-0 lg:text-white lg:text-lg lg:w-3/4 flex items-center font-light z-50"
  >
    <div class="flex flex-col lg:m-auto lg:w-1/2 lg:-translate-x-1/4">
      <h2
        id="hero-title"
        class="font-trajan
       text-2xl lg:text-4xl
       text-[var(--hero-text-color)]
       lg:text-white
       duration-1000 ease-in-out"
      >
        <PJRLogoEmblem class="size-24 mx-auto lg:mx-0 lg:size-36 fill-current block" />{title}
      </h2>
      <p class="lg:text-lg max-w-[600px] leading-loose">
        {description}
      </p>
    </div>
  </div>
</div>
<script type="module">
  const delay = 5000
  const images = document.querySelectorAll("[data-hero]")
  const backgrounds = document.querySelectorAll("[data-hero-bg]")
  const heroTitle = document.getElementById("hero-title")

  if (!images.length || !backgrounds.length || !heroTitle) return

  // pull the colors out of your data-color attrs
  const slideColors = Array.from(backgrounds).map((bg) =>
    bg.getAttribute("data-color")
  )

  let current = 0
  // initialize the CSS var
  heroTitle.style.setProperty("--hero-text-color", slideColors[0])

  setInterval(() => {
    // hide current slide
    images[current].classList.replace("opacity-100", "opacity-0")
    backgrounds[current].classList.replace("opacity-100", "opacity-0")

    // advance
    current = (current + 1) % images.length

    // show next slide
    images[current].classList.replace("opacity-0", "opacity-100")
    backgrounds[current].classList.replace("opacity-0", "opacity-100")

    // update the CSS var for text color
    heroTitle.style.setProperty("--hero-text-color", slideColors[current])
  }, delay)
</script>
