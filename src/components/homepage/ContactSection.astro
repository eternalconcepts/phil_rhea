---
import CalendarForm from "./CalendarForm.astro"
---

<section
  class="bg-stone-100 py-10 min-h-screen flex flex-col items-center justify-center"
>
  <div
    class="w-11/12 max-w-[1200px] mx-auto grid grid-cols-1 lg:grid-cols-2 gap-x-10"
  >
    <h2 class="text-2xl font-semibold w-full lg:col-span-2">Contact</h2>
    <CalendarForm />
    <div>
      <form action="/contact" method="POST" class="w-11/12 mx-auto">
        <h3>Start a conversation</h3>
        <div class="mb-4">
          <label for="name" class="block text-sm font-medium text-gray-700"
            >Name</label
          >
          <input
            type="text"
            id="name"
            name="name"
            class="mt-1 p-2 w-full border border-gray-300 rounded-md bg-white"
          />
        </div>
        <button
          type="submit"
          class="border-2 border-stone-400 rounded-lg p-3 text-stone-400 uppercase"
        >
          Send Message
        </button>
      </form>
      <hr />
      <p class="mt-4">or</p>
      <div>
        <h3>Follow on Social Media</h3>
        <div class="flex flex-row items-center justify-center">
          <div class="size-8 border-2 border-white p-2 rounded-lg">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="currentColor"
              viewBox="0 0 320 512"
            >
              <path
                d="M80 299.3V512H196V299.3h86.5l18-97.8H196V166.9c0-51.7 20.3-71.5 72.7-71.5c16.3 0 29.4 .4 37 1.2V7.9C291.4 4 256.4 0 236.2 0C129.3 0 80 50.5 80 159.4v42.1H14v97.8H80z"
              ></path>
            </svg>
          </div>
          <div class="size-8 border-2 border-white p-1 rounded-lg">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="currentColor"
              viewBox="0 0 576 512"
            >
              <path
                d="M549.7 124.1c-6.3-23.7-24.8-42.3-48.3-48.6C458.8 64 288 64 288 64S117.2 64 74.6 75.5c-23.5 6.3-42 24.9-48.3 48.6-11.4 42.9-11.4 132.3-11.4 132.3s0 89.4 11.4 132.3c6.3 23.7 24.8 41.5 48.3 47.8C117.2 448 288 448 288 448s170.8 0 213.4-11.5c23.5-6.3 42-24.2 48.3-47.8 11.4-42.9 11.4-132.3 11.4-132.3s0-89.4-11.4-132.3zm-317.5 213.5V175.2l142.7 81.2-142.7 81.2z"
              ></path>
            </svg>
          </div>
          <div class="size-8 border-2 border-white p-1 rounded-lg">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="currentColor"
              viewBox="0 0 448 512"
            >
              <path
                d="M100.3 448H7.4V148.9h92.9zM53.8 108.1C24.1 108.1 0 83.5 0 53.8a53.8 53.8 0 0 1 107.6 0c0 29.7-24.1 54.3-53.8 54.3zM447.9 448h-92.7V302.4c0-34.7-.7-79.2-48.3-79.2-48.3 0-55.7 37.7-55.7 76.7V448h-92.8V148.9h89.1v40.8h1.3c12.4-23.5 42.7-48.3 87.9-48.3 94 0 111.3 61.9 111.3 142.3V448z"
              ></path>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
