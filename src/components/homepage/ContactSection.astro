---

---

<style>
  /* base state: label text centered in field */
  label p {
    position: absolute;
    left: 1rem;
    top: 1.65rem;
    transform-origin: top left;
    transform: translateY(-50%);
    color: black; /* text-gray-500 */
    transition: all 0.15s ease-out;
    pointer-events: none;
  }
  /* active (focused or has content): move up, shrink, lighten */
  label.active p {
    top: 0;
    letter-spacing: 0.05em;
    transform: translateY(0.1rem) scale(0.8);
    color: #9ca3af; /* text-gray-400 */
  }
</style>
<section
  class="bg-stone-100 py-10 min-h-screen flex flex-col items-center justify-center"
>
  <div class="w-11/12 max-w-[700px] mx-auto">
    <h2 class="text-2xl font-semibold w-full">Parley</h2>
    <form
      id="contact-form"
      action="/api/contact"
      method="POST"
      class="mx-auto flex flex-col gap-4"
    >
      <h3>Start a conversation</h3>
      <label for="name" class="block text-sm font-medium relative">
        <p>Name</p>
        <input
          type="text"
          id="name"
          name="name"
          required
          class="p-4 h-14 w-full border border-gray-300 rounded-md bg-white text-base focus:shadow-xl focus:outline-none"
          placeholder=""
        />
      </label>

      <label for="phone" class="block text-sm font-medium relative"
        ><p class="absolute top-0 translate-y-0">Telephone</p>
        <input
          type="tel"
          id="phone"
          name="phone"
          required
          class="p-4 h-14 w-full border border-gray-300 rounded-md bg-white text-base focus:shadow-xl focus:outline-none"
          placeholder=""
        />
      </label>
      <label for="email" class="block text-sm font-medium relative"
        ><p class="absolute top-0 translate-y-0">E-Mail</p>
        <input
          type="email"
          id="email"
          name="email"
          required
          class="p-4 h-14 w-full border border-gray-300 rounded-md bg-white text-base focus:shadow-xl focus:outline-none"
          placeholder=""
        />
      </label>

      <label
        for="message"
        class="block text-sm font-medium text-gray-700 relative"
        ><p class="absolute top-0 translate-y-0">Message</p>
        <textarea
          id="message"
          name="message"
          rows="5"
          required
          class="p-4 w-full border border-gray-300 rounded-md bg-white text-base focus:shadow-xl focus:outline-none"
          placeholder=""></textarea>
      </label>
      <button
        id="contact-submit"
        type="submit"
        class="grid grid-cols-[auto_1fr] relative w-[14rem] items-center justify-center border-2 border-rose-600 lg:border-stone-400 rounded-lg p-3 text-rose-600 lg:text-stone-400 uppercase bg-white lg:bg-transparent hover:border-rose-600 hover:text-rose-600 hover:bg-white hover:-translate-y-1 duration-200 ease-in-out hover:shadow-xl cursor-pointer"
      >
        <!-- default label -->
        <svg
          class="btn-send size-7 fill-current"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="-1 -1 34 34"
          stroke="currentColor"
        >
          <path
            d="M16 0c-8.838 0-16 7.162-16 16s7.162 16 16 16 16-7.163 16-16-7.163-16-16-16zM23.863 10.969l-2.625 12.369c-0.181 0.881-0.712 1.087-1.45 0.681l-4-2.956-1.919 1.869c-0.225 0.219-0.4 0.4-0.8 0.4-0.519 0-0.431-0.194-0.606-0.688l-1.363-4.475-3.956-1.231c-0.856-0.262-0.862-0.85 0.194-1.269l15.412-5.95c0.7-0.319 1.381 0.169 1.113 1.25z"
          ></path>
        </svg>
        <!-- spinner (hidden by default) -->
        <svg
          class="btn-spinner hidden size-6 animate-spin"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
        >
          <circle
            class="opacity-25 stroke-current"
            cx="12"
            cy="12"
            r="10"
            stroke-width="4"></circle>
          <path
            class="opacity-75 fill-current"
            d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
        </svg>

        <!-- checkmark (hidden by default) -->
        <svg
          class="btn-check hidden size-6 fill-current"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 32 32"
        >
          <path
            d="M28 0h-24c-2.2 0-4 1.8-4 4v24c0 2.2 1.8 4 4 4h24c2.2 0 4-1.8 4-4v-24c0-2.2-1.8-4-4-4zM14 24.828l-7.414-7.414 2.828-2.828 4.586 4.586 9.586-9.586 2.828 2.828-12.414 12.414z"
          ></path>
        </svg>
        <p class="btn-label">SEND MESSAGE</p>
      </button>
    </form>
    <div
      class="w-full relative grid grid-cols-1 lg:grid-cols-[1fr_auto_1fr] gap-4 my-10"
    >
      <div>
        <h3>Follow on Social Media</h3>
        <div
          class="flex flex-row items-center justify-start gap-5 text-rose-600 lg:text-stone-400 *:hover:text-rose-600 *:duration-200 ease-out"
        >
          <a
            href="https://www.pinterest.com/philipjrhea/"
            target="_blank"
            class="size-11"
            aria-label="Pinterest Link"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="currentColor"
              viewBox="0 0 32 32"
            >
              <path
                d="M16 2.138c-7.656 0-13.863 6.206-13.863 13.863 0 5.875 3.656 10.887 8.813 12.906-0.119-1.094-0.231-2.781 0.050-3.975 0.25-1.081 1.625-6.887 1.625-6.887s-0.412-0.831-0.412-2.056c0-1.925 1.119-3.369 2.506-3.369 1.181 0 1.756 0.887 1.756 1.95 0 1.188-0.756 2.969-1.15 4.613-0.331 1.381 0.688 2.506 2.050 2.506 2.462 0 4.356-2.6 4.356-6.35 0-3.319-2.387-5.638-5.787-5.638-3.944 0-6.256 2.956-6.256 6.019 0 1.194 0.456 2.469 1.031 3.163 0.113 0.137 0.131 0.256 0.094 0.4-0.106 0.438-0.338 1.381-0.387 1.575-0.063 0.256-0.2 0.306-0.463 0.188-1.731-0.806-2.813-3.337-2.813-5.369 0-4.375 3.175-8.387 9.156-8.387 4.806 0 8.544 3.425 8.544 8.006 0 4.775-3.012 8.625-7.194 8.625-1.406 0-2.725-0.731-3.175-1.594 0 0-0.694 2.644-0.863 3.294-0.313 1.206-1.156 2.712-1.725 3.631 1.3 0.4 2.675 0.619 4.106 0.619 7.656 0 13.863-6.206 13.863-13.863 0-7.662-6.206-13.869-13.863-13.869z"
              ></path>
            </svg>
          </a>
          <a
            href="https://www.linkedin.com/in/philip-rhea-51b791b/"
            target="_blank"
            class="size-10"
            arial-label="LinkedIn Link"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="currentColor"
              viewBox="0 0 32 32"
            >
              <path
                d="M29 0h-26c-1.65 0-3 1.35-3 3v26c0 1.65 1.35 3 3 3h26c1.65 0 3-1.35 3-3v-26c0-1.65-1.35-3-3-3zM12 26h-4v-14h4v14zM10 10c-1.106 0-2-0.894-2-2s0.894-2 2-2c1.106 0 2 0.894 2 2s-0.894 2-2 2zM26 26h-4v-8c0-1.106-0.894-2-2-2s-2 0.894-2 2v8h-4v-14h4v2.481c0.825-1.131 2.087-2.481 3.5-2.481 2.488 0 4.5 2.238 4.5 5v9z"
              ></path>
            </svg>
          </a>
          <a
            href="https://www.youtube.com/@eternal-concepts"
            target="_blank"
            class="size-10"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="currentColor"
              viewBox="0 0 32 32"
            >
              <path
                d="M31.681 9.6c0 0-0.313-2.206-1.275-3.175-1.219-1.275-2.581-1.281-3.206-1.356-4.475-0.325-11.194-0.325-11.194-0.325h-0.012c0 0-6.719 0-11.194 0.325-0.625 0.075-1.987 0.081-3.206 1.356-0.963 0.969-1.269 3.175-1.269 3.175s-0.319 2.588-0.319 5.181v2.425c0 2.587 0.319 5.181 0.319 5.181s0.313 2.206 1.269 3.175c1.219 1.275 2.819 1.231 3.531 1.369 2.563 0.244 10.881 0.319 10.881 0.319s6.725-0.012 11.2-0.331c0.625-0.075 1.988-0.081 3.206-1.356 0.962-0.969 1.275-3.175 1.275-3.175s0.319-2.587 0.319-5.181v-2.425c-0.006-2.588-0.325-5.181-0.325-5.181zM12.694 20.15v-8.994l8.644 4.513-8.644 4.481z"
              ></path>
            </svg>
          </a>
        </div>
      </div>
      <div
        class="h-full w-10/12 lg:w-4 mx-auto border-t lg:border-t-0 lg:border-l relative border-stone-400 text-stone-400"
      >
        <p
          class="absolute top-1/2 -translate-y-1/2 left-1/2 lg:left-0 -translate-x-[50%] bg-stone-100 p-2"
        >
          or
        </p>
      </div>
      <div
        class="h-full w-full flex items-center justify-center lg:justify-end py-3"
      >
        <a
          href="/calendar"
          arial-label="Schedule a call button"
          class="border-2 border-stone-400 text-stone-500 flex items-center justify-center rounded-xl max-w-60 w-full h-full gap-3 p-4"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="currentColor"
            class="size-6"
            viewBox="0 0 32 32"
          >
            <path
              d="M10 12h4v4h-4zM16 12h4v4h-4zM22 12h4v4h-4zM4 24h4v4h-4zM10 24h4v4h-4zM16 24h4v4h-4zM10 18h4v4h-4zM16 18h4v4h-4zM22 18h4v4h-4zM4 18h4v4h-4zM26 0v2h-4v-2h-14v2h-4v-2h-4v32h30v-32h-4zM28 30h-26v-22h26v22z"
            ></path>
          </svg>
          SCHEDULE A CALL</a
        >
      </div>
    </div>
  </div>
  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      // --- Floating labels (unchanged) ---
      document.querySelectorAll("input, textarea").forEach((input) => {
        const label = document.querySelector(`label[for="${input.id}"]`)
        input.addEventListener("focus", () => label?.classList.add("active"))
        input.addEventListener("blur", () => {
          if (!input.value) label?.classList.remove("active")
        })
      })

      // --- AJAX submit + state toggling ---
      const form = document.getElementById("contact-form")
      const btn = document.getElementById("contact-submit")
      const sendIcon = btn.querySelector(".btn-send")
      const spinner = btn.querySelector(".btn-spinner")
      const check = btn.querySelector(".btn-check")
      const labelEl = btn.querySelector(".btn-label")

      form.addEventListener("submit", async (e) => {
        e.preventDefault()
        btn.disabled = true

        // → Enter “Sending Message” state
        sendIcon.classList.add("hidden")
        check.classList.add("hidden")
        spinner.classList.remove("hidden")
        labelEl.textContent = "Sending Message"

        try {
          const res = await fetch(form.action, {
            method: "POST",
            body: new FormData(form),
          })
          if (!res.ok) {
            const { error } = await res.json()
            throw new Error(error || "Submit failed")
          }

          // → Enter “Message Sent” state
          spinner.classList.add("hidden")
          check.classList.remove("hidden")
          check.classList.add("text-green-500")
          labelEl.classList.add("text-green-500")
          labelEl.textContent = "Message Sent"
          form.reset()
          form.querySelectorAll("input, textarea").forEach((el) => {
            el.disabled = true
            el.classList.add("opacity-50", "cursor-not-allowed")
          })

          // → After 5s, restore initial state
          setTimeout(() => {
            form.querySelectorAll("input, textarea").forEach((el) => {
              el.disabled = false
              el.classList.remove("opacity-50", "cursor-not-allowed")
            })
            check.classList.add("hidden")
            spinner.classList.add("hidden")
            sendIcon.classList.remove("hidden")
            labelEl.textContent = "Send Message"
            btn.disabled = false
          }, 5000)
        } catch (err) {
          console.error(err)
          // → On error, roll back to initial state
          spinner.classList.add("hidden")
          sendIcon.classList.remove("hidden")
          check.classList.add("hidden")
          labelEl.textContent = "Send Message"
          btn.disabled = false
          alert(err.message)
        }
      })
    })
  </script>
</section>
