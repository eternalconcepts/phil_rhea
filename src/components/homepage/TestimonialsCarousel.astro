---
import TestimonialsCard from "../TestimonialsCard.astro"
import fetchApi from "../../lib/strapi"

const { data: page, error } = await fetchApi({
  endpoint: "home-page",
  query: { Testimonials: "", populate: "*" },
})
if (error) console.error("Strapi error:", error)

const testimonials = page?.Testimonials || []
---

<div id="carousel-wrapper" class="relative overflow-hidden mx-auto p-5">
  <!-- track of slides -->
  <div
    id="carousel-track"
    class="flex transition-transform duration-300 will-change-transform"
  >
    {
      testimonials.map((t, i) => (
        <div
          class="min-w-full md:min-w-1/2 lg:min-w-1/3 xl:min-w-1/4 flex-shrink-0"
          key={i}
        >
          <TestimonialsCard
            referralText={t.referral_text}
            referralPerson={t.referral_person}
          />
        </div>
      ))
    }
  </div>

  <!-- prev/next (hidden by default) -->
  <button
    id="carousel-prev"
    class="absolute top-1/2 -left-4 transform -translate-y-1/2 p-2 bg-white rounded-full shadow"
    style="display:none"
    aria-label="Previous slide"
  >
    ‹
  </button>
  <button
    id="carousel-next"
    class="absolute top-1/2 -right-4 transform -translate-y-1/2 p-2 bg-white rounded-full shadow"
    style="display:none"
    aria-label="Next slide"
  >
    ›
  </button>

  <!-- dots container -->
  <div id="carousel-dots" class="flex justify-center gap-2 mt-4"></div>
</div>

<script is:inline client:load>
  ;(() => {
    const wrapper = document.getElementById("carousel-wrapper")
    const track = document.getElementById("carousel-track")
    const prev = document.getElementById("carousel-prev")
    const next = document.getElementById("carousel-next")
    const dotsC = document.getElementById("carousel-dots")
    const slides = Array.from(track.children)
    let perView = 1
    let index = 0
    let maxIndex = 0

    function calcPerView() {
      const w = window.innerWidth
      if (w >= 1280) perView = 4
      else if (w >= 1024) perView = 3
      else if (w >= 768) perView = 2
      else perView = 1
    }

    function buildDots() {
      dotsC.innerHTML = ""
      maxIndex = Math.max(slides.length - perView, 0)
      for (let i = 0; i <= maxIndex; i++) {
        const btn = document.createElement("button")
        btn.className = "w-3 h-3 rounded-full bg-gray-300"
        btn.addEventListener("click", () => {
          index = i
          update()
        })
        dotsC.appendChild(btn)
      }
    }

    function update() {
      // clamp index
      if (index > maxIndex) index = maxIndex
      if (index < 0) index = 0
      // slide by full wrapper-width each time
      const move = wrapper.clientWidth * index
      track.style.transform = `translateX(-${move}px)`

      // arrows visibility
      if (maxIndex > 0) {
        prev.style.display = index > 0 ? "block" : "none"
        next.style.display = index < maxIndex ? "block" : "none"
      } else {
        prev.style.display = "none"
        next.style.display = "none"
      }

      // dots visibility and active state
      if (maxIndex > 0) {
        dotsC.style.display = "flex"
        Array.from(dotsC.children).forEach((btn, i) => {
          btn.classList.toggle("bg-gray-700", i === index)
        })
      } else {
        dotsC.style.display = "none"
      }
    }

    prev.addEventListener("click", () => {
      index = index - 1
      update()
    })
    next.addEventListener("click", () => {
      index = index + 1
      update()
    })

    window.addEventListener("resize", () => {
      const old = perView
      calcPerView()
      if (perView !== old) {
        buildDots()
        update()
      }
    })

    // init
    calcPerView()
    buildDots()
    update()
  })()
</script>
