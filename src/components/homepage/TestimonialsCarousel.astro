---
import TestimonialsCard from "../TestimonialsCard.astro"
import fetchApi from "../../lib/strapi"

const { data: page, error } = await fetchApi({
  endpoint: "home-page",
  query: { Testimonials: "", populate: "*" },
})
if (error) console.error("Strapi error:", error)

const testimonials = page?.Testimonials || []
---

<div id="carousel" class="relative mx-auto w-full">
  <!-- 1) GRID track: each slide is 100%/per-view via grid-auto-columns -->
  <div
    id="carousel-wrapper"
    class="overflow-x-auto scrollbar-track-transparent scrollbar-thumb-transparent w-full scroll-smooth"
  >
    <div id="carousel-track" class="gap-5 grid grid-flow-col">
      {
        testimonials.map((t, i) => (
          <TestimonialsCard
            class="w-[calc(91.6vw)]"
            referralText={t.referral_text}
            referralPerson={t.referral_person}
          />
        ))
      }
    </div>
  </div>

  <!-- prev/next -->
  <button
    id="carousel-prev"
    class="absolute top-1/2 left-2 -translate-y-1/2 bg-white rounded-full border-2 lg:border-stone-400 lg:text-stone-400 hover:border-rose-600 hover:text-rose-600 border-rose-600 text-rose-600 duration-200"
    style="display:none"
    aria-label="Previous slide"
  >
    <svg
      class="fill-current size-8 p-1 rounded-full"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 32 32"
    >
      <path
        d="M20.914 9.914l-2.829-2.829-8.914 8.914 8.914 8.914 2.828-2.828-6.086-6.086z"
      ></path>
    </svg>
  </button>

  <button
    id="carousel-next"
    class="absolute top-1/2 right-2 -translate-y-1/2 bg-white rounded-full border-2 lg:border-stone-400 lg:text-stone-400 hover:border-rose-600 hover:text-rose-600 border-rose-600 text-rose-600 duration-200"
    style="display:none"
    aria-label="Next slide"
  >
    <svg
      class="fill-current size-8 p-1 rounded-full rotate-180"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 32 32"
    >
      <path
        d="M20.914 9.914l-2.829-2.829-8.914 8.914 8.914 8.914 2.828-2.828-6.086-6.086z"
      ></path>
    </svg>
  </button>

  <!-- dots -->
  <div id="carousel-dots" class="flex justify-center gap-2 mt-4"></div>
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const wrapper = document.getElementById("carousel-wrapper")
      const track = document.getElementById("carousel-track")
      const prevBtn = document.getElementById("carousel-prev")
      const nextBtn = document.getElementById("carousel-next")
      const dotsCon = document.getElementById("carousel-dots")
      const slides = Array.from(track.children)

      // ← how many dots/pages you want
      const dotsCount = slides.length
      // each dot covers this many slides
      const groupSize = Math.ceil(slides.length / dotsCount)

      let slideWidth,
        gapSize,
        segmentWidth,
        current = 0

      function rebuild() {
        // measure one slide + gap
        slideWidth = slides[0].clientWidth
        const style = getComputedStyle(track)
        gapSize = parseFloat(style.columnGap) || parseFloat(style.gap) || 0
        segmentWidth = (slideWidth + gapSize) * groupSize

        // hide dots/arrows if no overflow
        const overflow = track.scrollWidth > wrapper.clientWidth + 1
        dotsCon.style.display = overflow ? "flex" : "none"
        prevBtn.style.display = "none"
        nextBtn.style.display = "none"
        if (!overflow) return

        // build dots
        dotsCon.innerHTML = ""
        for (let i = 0; i < dotsCount; i++) {
          const d = document.createElement("button")
          d.className = "h-2 w-2 rounded-full bg-gray-400"
          d.addEventListener("click", () => goToPage(i))
          dotsCon.appendChild(d)
        }

        // ensure UI matches current
        updateUI()
      }

      function goToPage(i) {
        current = i
        // jump by exact page width
        wrapper.scrollTo({ left: segmentWidth * i, behavior: "smooth" })
        updateUI()
      }

      function updateUI() {
        // arrows
        prevBtn.style.display = current === 0 ? "none" : "block"
        nextBtn.style.display = current === dotsCount - 1 ? "none" : "block"
        // dots
        dotsCon.querySelectorAll("button").forEach((b, idx) => {
          b.classList.toggle("bg-red-700", idx === current)
          b.classList.toggle("bg-gray-400", idx !== current)
        })
      }

      // prev/next
      prevBtn.addEventListener("click", () =>
        goToPage(Math.max(0, current - 1))
      )
      nextBtn.addEventListener("click", () =>
        goToPage(Math.min(dotsCount - 1, current + 1))
      )

      // on user scroll/swipe → update “current” and UI
      wrapper.addEventListener(
        "scroll",
        () => {
          const newIndex = Math.round(wrapper.scrollLeft / segmentWidth)
          if (newIndex !== current) {
            current = newIndex
            updateUI()
          }
        },
        { passive: true }
      )

      // recalc on resize
      window.addEventListener("resize", rebuild)

      // kick it off
      rebuild()
    })
  </script>
</div>
