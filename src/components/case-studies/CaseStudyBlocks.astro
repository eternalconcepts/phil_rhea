---
import Youtube from "../portfolio/Youtube.astro"

const { blocks = [], title = "Case study" } = Astro.props

function getYouTubeId(url) {
  try {
    const parsed = new URL(url)

    if (parsed.hostname.includes("youtu.be")) {
      return parsed.pathname.replace(/^\//, "")
    }

    if (parsed.hostname.includes("youtube.com")) {
      if (parsed.pathname === "/watch") {
        return parsed.searchParams.get("v")
      }

      if (parsed.pathname.startsWith("/embed/")) {
        return parsed.pathname.split("/embed/")[1]
      }

      if (parsed.pathname.startsWith("/shorts/")) {
        return parsed.pathname.split("/shorts/")[1]
      }
    }
  } catch {
    return null
  }

  return null
}
---

<div class="space-y-10">
  {
    blocks.map((block, index) => {
      if (block.type === "long-text") {
        return (
          <section class="rounded-[2rem] border border-stone-300 bg-white p-6 shadow-sm sm:p-8">
            {block.heading ? <h2 class="text-2xl sm:text-3xl">{block.heading}</h2> : null}
            <div
              class:list={[
                "max-w-none text-stone-700 [&_a]:text-stone-900 [&_a]:underline [&_li]:leading-8 [&_ol]:ml-6 [&_ol]:list-decimal [&_p]:text-lg [&_p]:leading-8 [&_ul]:ml-6 [&_ul]:list-disc [&_ul]:space-y-2 [&_p+*]:mt-6",
                block.heading ? "mt-5" : "",
              ]}
              set:html={block.content}
            />
          </section>
        )
      }

      if (block.type === "image" && block.image) {
        return (
          <figure class="overflow-hidden rounded-[2rem] border border-stone-300 bg-white shadow-sm">
            {block.heading ? <div class="px-6 pt-6 text-2xl sm:text-3xl">{block.heading}</div> : null}
            <img
              src={block.image.url}
              width={block.image.width}
              height={block.image.height}
              alt={block.image.alt}
              srcset={block.image.srcSet || undefined}
              sizes="(min-width: 1280px) 1200px, 100vw"
              loading="lazy"
              decoding="async"
              class:list={["w-full object-cover", block.heading ? "mt-6" : ""]}
            />
            {block.caption ? <figcaption class="px-6 py-4 text-sm leading-7 text-stone-500">{block.caption}</figcaption> : null}
          </figure>
        )
      }

      if (block.type === "gallery" && block.images?.length) {
        return (
          <section class="rounded-[2rem] border border-stone-300 bg-white p-6 shadow-sm sm:p-8">
            {block.heading ? <h2 class="text-2xl sm:text-3xl">{block.heading}</h2> : null}
            {block.caption ? <p class:list={["text-sm leading-7 text-stone-500", block.heading ? "mt-3" : ""]}>{block.caption}</p> : null}
            <div class:list={["grid gap-4 sm:grid-cols-2", block.heading || block.caption ? "mt-6" : ""]}>
              {block.images.map((image) => (
                <figure class="overflow-hidden rounded-[1.5rem] bg-stone-100">
                  <img
                    src={image.url}
                    width={image.width}
                    height={image.height}
                    alt={image.alt}
                    srcset={image.srcSet || undefined}
                    sizes="(min-width: 640px) 50vw, 100vw"
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover"
                  />
                </figure>
              ))}
            </div>
          </section>
        )
      }

      if (block.type === "video") {
        const youtubeId = getYouTubeId(block.url)
        const videoTitle = block.title || `${title} video ${index + 1}`

        return (
          <section class="rounded-[2rem] border border-stone-300 bg-white p-4 shadow-sm sm:p-6">
            {
              youtubeId ? (
                <Youtube videoId={youtubeId} alt={videoTitle} index={index} />
              ) : (
                <a
                  href={block.url}
                  target="_blank"
                  rel="noreferrer"
                  class="flex aspect-video items-center justify-center rounded-xl border border-stone-300 bg-stone-100 p-6 text-center text-sm uppercase tracking-[0.2em] text-stone-600"
                >
                  Open video
                </a>
              )
            }
            {block.title ? <h2 class="mt-5 text-2xl">{block.title}</h2> : null}
            {block.caption ? <p class="mt-3 text-sm leading-7 text-stone-500">{block.caption}</p> : null}
          </section>
        )
      }

      return null
    })
  }
</div>
