---
import CaseStudyBlocks from "../../components/case-studies/CaseStudyBlocks.astro"
import Layout from "../../components/layout/Layout.astro"
import { sampleCaseStudy } from "../../lib/sample-content"
import { isTemporaryStrapiError } from "../../lib/strapi-request"
import {
  fetchCaseStudies,
  fetchCaseStudyBySlug,
  isCaseStudyAuthConfigured,
  isCaseStudyConfigured,
} from "../../lib/server/case-studies"

export async function getStaticPaths() {
  const sampleEntry = {
    params: {
      slug: sampleCaseStudy.slug,
    },
    props: {
      caseStudy: sampleCaseStudy,
    },
  }

  if (!isCaseStudyConfigured()) {
    return [sampleEntry]
  }

  try {
    const caseStudies = await fetchCaseStudies()
    const entries = await Promise.all(
      caseStudies.map(async (caseStudy) => ({
        slug: caseStudy.slug,
        caseStudy: await fetchCaseStudyBySlug(caseStudy.slug),
      }))
    )

    const staticEntries = entries
      .filter((entry) => entry.caseStudy)
      .map((entry) => ({
        params: {
          slug: entry.slug,
        },
        props: {
          caseStudy: entry.caseStudy,
        },
      }))
      .filter((entry) => entry.params.slug !== sampleCaseStudy.slug)
    return [sampleEntry, ...staticEntries]
  } catch (error) {
    console.error("Unable to generate static case-study pages.", error)
    if (isTemporaryStrapiError(error)) {
      return []
    }
    return [sampleEntry]
  }
}

const { caseStudy = null } = Astro.props
const hasAuth = isCaseStudyAuthConfigured()
const isSampleCaseStudy = caseStudy?.slug === sampleCaseStudy.slug
---

<Layout
  title={caseStudy ? `${caseStudy.title} | Case Studies` : "Case Studies | Eternal Concepts by Philip J. Rhea"}
  description={caseStudy?.shortDescription || "Case study details for Eternal Concepts by Philip J. Rhea."}
>
  {
    !caseStudy ? (
      <section class="grid min-h-[70vh] place-items-center px-6 text-center text-stone-700">
        <div class="max-w-xl space-y-4">
          <p class="text-sm uppercase tracking-[0.4em] text-stone-400">Case Studies</p>
          <h1 class="text-4xl">Case study not found</h1>
          <p class="leading-8 text-stone-500">
            This case study does not exist yet or is not published in Strapi.
          </p>
          {
            !hasAuth ? (
              <p class="text-sm text-amber-800">
                If this content is not public in Strapi, add `STRAPI_API_TOKEN` to the Astro app.
              </p>
            ) : null
          }
          <a href="/case-studies" class="inline-flex border border-stone-300 px-6 py-3 text-sm uppercase tracking-[0.25em] text-stone-700">
            Back to case studies
          </a>
        </div>
      </section>
    ) : (
      <>
        {
          isSampleCaseStudy ? (
            <section class="bg-amber-50 px-6 py-4 text-center text-sm text-amber-900">
              Sample case-study page shown because local Strapi case-study content is not available yet.
            </section>
          ) : null
        }
        <section class="relative isolate overflow-hidden bg-stone-900 text-white">
          {
            caseStudy.coverImage ? (
              <div class="absolute inset-0">
                <img
                  src={caseStudy.coverImage.largeUrl || caseStudy.coverImage.url}
                  alt={caseStudy.coverImage.alt}
                  class="h-full w-full object-cover"
                  loading="eager"
                />
              </div>
            ) : (
              <div class="absolute inset-0 bg-[linear-gradient(135deg,#57534e_0%,#292524_48%,#0c0a09_100%)]"></div>
            )
          }
          <div class="absolute inset-0 bg-[linear-gradient(135deg,rgba(12,10,9,0.88)_0%,rgba(12,10,9,0.74)_42%,rgba(12,10,9,0.82)_100%)]"></div>
          <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(255,255,255,0.18),transparent_34%)]"></div>

          <div class="relative mx-auto flex min-h-[58vh] w-11/12 max-w-[1366px] flex-col justify-end py-14 sm:py-18 lg:min-h-[68vh] lg:py-24">
            <div class="max-w-5xl">
              <div class="text-[0.72rem] uppercase tracking-[0.32em] text-stone-300">
                <a href="/" class="transition hover:text-white">Home</a>
                <span class="px-2 text-stone-500">/</span>
                <a href="/case-studies" class="transition hover:text-white">Case Studies</a>
                <span class="px-2 text-stone-500">/</span>
                <span class="text-white">{caseStudy.title}</span>
              </div>

              <p class="mt-8 text-[0.72rem] uppercase tracking-[0.35em] text-stone-300">Case study</p>
              <h1 class="mt-4 max-w-4xl text-4xl leading-tight sm:text-5xl lg:text-7xl">{caseStudy.title}</h1>
              {caseStudy.shortDescription ? (
                <p class="mt-6 max-w-3xl text-base leading-8 text-stone-200 sm:text-lg">
                  {caseStudy.shortDescription}
                </p>
              ) : null}
              {!caseStudy.shortDescription && caseStudy.intro ? (
                <div
                  class="mt-6 max-w-3xl text-base leading-8 text-stone-200 sm:text-lg [&_p+*]:mt-5"
                  set:html={caseStudy.intro}
                />
              ) : null}
            </div>
          </div>
        </section>

        <section class="bg-stone-100 px-6 py-12 sm:px-10 lg:px-16 lg:py-18">
          <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[minmax(0,1.2fr)_minmax(280px,0.8fr)] lg:gap-14">
            <div>
              {caseStudy.blocks.length > 0 ? <CaseStudyBlocks blocks={caseStudy.blocks} title={caseStudy.title} /> : (
                <div class="rounded-[2rem] border border-stone-300 bg-white p-6 text-lg leading-8 text-stone-600 shadow-sm sm:p-8">
                  Content blocks will appear here when they are added in Strapi.
                </div>
              )}
            </div>

            <aside class="h-fit rounded-[2rem] border border-stone-300 bg-white p-6 shadow-sm sm:p-8">
              <p class="text-sm uppercase tracking-[0.3em] text-stone-400">Page details</p>
              <div class="mt-6 space-y-5 text-stone-700">
                <div>
                  <p class="text-[0.68rem] uppercase tracking-[0.25em] text-stone-400">Content blocks</p>
                  <p class="mt-2 leading-7">{caseStudy.blocks.length}</p>
                </div>
                {
                  caseStudy.unsupportedBlockCount > 0 ? (
                    <div>
                      <p class="text-[0.68rem] uppercase tracking-[0.25em] text-stone-400">Hidden blocks</p>
                      <p class="mt-2 leading-7">
                        {caseStudy.unsupportedBlockCount} block{caseStudy.unsupportedBlockCount === 1 ? "" : "s"} are not yet mapped in the frontend.
                      </p>
                    </div>
                  ) : null
                }
                <div>
                  <p class="text-[0.68rem] uppercase tracking-[0.25em] text-stone-400">Format</p>
                  <p class="mt-2 leading-7">Long text, image, and video sections from Strapi</p>
                </div>
              </div>

              <div class="mt-8 flex flex-col gap-3">
                <a
                  href="/case-studies"
                  class="inline-flex items-center justify-center rounded-full border border-stone-300 px-5 py-3 text-sm uppercase tracking-[0.22em] text-stone-700 transition hover:border-stone-900 hover:text-stone-950"
                >
                  Back to archive
                </a>
                <a
                  href="/portfolio"
                  class="inline-flex items-center justify-center rounded-full border border-stone-300 px-5 py-3 text-sm uppercase tracking-[0.22em] text-stone-700 transition hover:border-stone-900 hover:text-stone-950"
                >
                  View portfolio
                </a>
              </div>
            </aside>
          </div>
        </section>
      </>
    )
  }
</Layout>
