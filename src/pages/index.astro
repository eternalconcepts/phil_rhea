---
import "../styles/global.css"
import { Image } from "astro:assets"
import heroBackground from "../images/sta_02.jpg"
import PJRLogoEmblem from "../components/icons/PJRLogoEmblem.astro"
import ContactForm from "../components/homepage/ContactForm.astro"
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Philip J. Rhea | Architect</title>
    <meta
      name="description"
      content="Architecture and design by Philip J. Rhea."
    />
  </head>
  <body class="m-0 bg-stone-950 text-white">
    <main class="relative isolate min-h-screen overflow-hidden">
      <Image
        src={heroBackground}
        alt=""
        widths={[750, 1080, 1600, 2200]}
        sizes="100vw"
        format="webp"
        quality={80}
        class="absolute inset-0 h-full w-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-stone-950/50 via-stone-950/20 to-stone-950/60"></div>
      <div class="absolute inset-0 radial-gradient-[ellipse_at_top_right,_var(--tw-gradient-stops)] from-stone-950/80 via-transparent to-stone-950/80"></div>
      </div>

      <section class="relative flex flex-col z-10 flex min-h-screen items-center justify-center gap-2">
<div class="min-w-[400px] w-[35vw] aspect-square rounded-full bg-radial from-black/70  to-black/0 to-70% absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 "/>
          <PJRLogoEmblem class="w-28 fill-white dropshadow-lg sm:w-32 z-1" />
          <p class="font-trajan text-sm uppercase tracking-loose text-stone-200 sm:text-base z-1">
            Philip J. Rhea<br/>Architect
          </p>
          <button
            type="button"
            class="rounded-full border border-white/70 bg-white/8 px-8 py-3 font-trajan text-sm uppercase tracking-[0.32em] text-white backdrop-blur-sm transition duration-300 hover:-translate-y-1
            hover:shadow-lg hover:bg-white hover:text-stone-900 cursor-pointer z-1"
            data-contact-open
          >
            Contact
          </button>


      </section>

      <ContactForm />
    </main>
  </body>
</html>
