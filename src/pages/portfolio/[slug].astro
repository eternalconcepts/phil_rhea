---
import Layout from "../../components/layout/Layout.astro"
import MediaGrid from "../../components/portfolio/MediaGrid.astro"
import { samplePortfolioProject } from "../../lib/sample-content"
import { isTemporaryStrapiError } from "../../lib/strapi-request"
import {
  fetchPortfolioProjectBySlug,
  fetchPortfolioProjects,
  isPortfolioAuthConfigured,
  isPortfolioConfigured,
} from "../../lib/server/portfolio"

export async function getStaticPaths() {
  const sampleEntry = {
    params: {
      slug: samplePortfolioProject.slug,
    },
    props: {
      project: samplePortfolioProject,
    },
  }

  if (!isPortfolioConfigured()) {
    return [sampleEntry]
  }

  try {
    const projects = await fetchPortfolioProjects()
    const entries = await Promise.all(
      projects.map(async (project) => ({
        slug: project.slug,
        project: await fetchPortfolioProjectBySlug(project.slug),
      }))
    )

    const staticEntries = entries
      .filter((entry) => entry.project)
      .map((entry) => ({
        params: {
          slug: entry.slug,
        },
        props: {
          project: entry.project,
        },
      }))
      .filter((entry) => entry.params.slug !== samplePortfolioProject.slug)
    return [sampleEntry, ...staticEntries]
  } catch (error) {
    console.error("Unable to generate static portfolio pages.", error)
    if (isTemporaryStrapiError(error)) {
      return []
    }
    return [sampleEntry]
  }
}

const { project = null } = Astro.props
const hasAuth = isPortfolioAuthConfigured()
const galleryImages = project
  ? [
      project.coverImage &&
      !project.images.some(
        (image) =>
          image.largeUrl === project.coverImage.largeUrl || image.url === project.coverImage.url,
      )
        ? project.coverImage
        : null,
      ...project.images,
    ].filter(Boolean)
  : []
const projectFacts = project
  ? [
      project.address ? { label: "Location", value: project.address } : null,
      project.siteArea ? { label: "Site Area", value: project.siteArea } : null,
      project.projectArea ? { label: "Project Area", value: project.projectArea } : null,
      project.category ? { label: "Project Category", value: project.category } : null,
      project.projectType ? { label: "Project Type", value: project.projectType } : null,
    ].filter(Boolean)
  : []
---

<Layout
  title={project ? `${project.title} | Portfolio` : "Portfolio | Eternal Concepts by Philip J. Rhea"}
  description={project?.shortDescription || "Portfolio project details for Eternal Concepts by Philip J. Rhea."}
>
  {
    !project ? (
      <section class="grid min-h-[70vh] place-items-center px-6 text-center text-stone-700">
        <div class="max-w-xl space-y-4">
          <p class="text-sm uppercase tracking-[0.4em] text-stone-400">Portfolio</p>
          <h1 class="text-4xl">Project not found</h1>
          <p class="leading-8 text-stone-500">
            This project does not exist yet or is not published in Strapi.
          </p>
          {
            !hasAuth ? (
              <p class="text-sm text-amber-800">
                If this content is not public in Strapi, add `STRAPI_API_TOKEN` to the Astro app.
              </p>
            ) : null
          }
          <a href="/portfolio" class="inline-flex border border-stone-300 px-6 py-3 text-sm uppercase tracking-[0.25em] text-stone-700">
            Back to portfolio
          </a>
        </div>
      </section>
    ) : (
      <>
        <section class="bg-[linear-gradient(180deg,#fafaf9_0%,#f3f1ed_100%)] px-6 py-12 sm:px-10 lg:px-16 lg:py-18">
          <div class="mx-auto max-w-6xl">
            <div class="text-[0.72rem] uppercase tracking-[0.32em] text-stone-400">
              <a href="/" class="transition hover:text-stone-900">Home</a>
              <span class="px-2 text-stone-300">/</span>
              <a href="/portfolio" class="transition hover:text-stone-900">Portfolio</a>
              <span class="px-2 text-stone-300">/</span>
              <span class="text-stone-700">{project.title}</span>
            </div>

            <div class="mt-10 grid gap-14 lg:grid-cols-[minmax(0,1.15fr)_320px] xl:grid-cols-[minmax(0,1.2fr)_360px]">
              <div class="max-w-3xl text-stone-600">
                <p class="text-[0.72rem] uppercase tracking-[0.34em] text-stone-400">Project</p>
                <h1 class="mt-4 text-4xl leading-tight text-stone-900 sm:text-5xl lg:text-6xl">
                  {project.title}
                </h1>

                {project.shortDescription ? (
                  <p class="mt-6 max-w-2xl text-lg leading-8 text-stone-600">
                    {project.shortDescription}
                  </p>
                ) : null}

                {
                  project.longDescription ? (
                    <div
                      class="mt-8 max-w-none text-stone-600 [&_a]:text-stone-900 [&_a]:underline [&_li]:leading-8 [&_ol]:ml-6 [&_ol]:list-decimal [&_p]:text-lg [&_p]:leading-8 [&_ul]:ml-6 [&_ul]:list-disc [&_ul]:space-y-2 [&_p+*]:mt-6"
                      set:html={project.longDescription}
                    />
                  ) : (
                    <p class="mt-8 text-lg leading-8 text-stone-500">
                      Additional project narrative will appear here when a long description is available in Strapi.
                    </p>
                  )
                }
              </div>

              <aside class=" border-l border-stone-300 pl-0 text-stone-600 lg:pl-8">
                <p class="text-[0.72rem] uppercase tracking-[0.34em] text-stone-700">Project details</p>
                <div class="flex flex-col gap-6 py-5">
                  {projectFacts.map((fact) => (
                    <div class="grid gap-1">
                      <p class="text-[0.68rem] uppercase tracking-[0.25em] text-stone-400">{fact.label}</p>
                      <p class="text-sm leading-6 text-stone-700">{fact.value}</p>
                    </div>
                  ))}
                </div>
              </aside>
            </div>
          </div>
        </section>

        {
          project.videos.length > 0 || galleryImages.length > 0 ? (
            <section class="bg-white px-6 py-12 sm:px-10 lg:px-16 lg:py-16">
              <div class="mx-auto max-w-6xl">
                <div class="mb-8 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
                  <div>
                    <p class="text-sm uppercase tracking-[0.3em] text-stone-400">Project media</p>
                    <h2 class="mt-2 text-3xl sm:text-4xl">Gallery and supporting visuals</h2>
                  </div>
                  <p class="max-w-xl text-sm leading-7 text-stone-500">
                    Open any image in a new tab, or review the masonry gallery below alongside any project video.
                  </p>
                </div>
                <MediaGrid videos={project.videos} images={galleryImages} projectTitle={project.title} />
              </div>
            </section>
          ) : null
        }
      </>
    )
  }
</Layout>
