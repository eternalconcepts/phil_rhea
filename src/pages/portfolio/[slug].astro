---
import Layout from "../../components/layout/Layout.astro"
import MediaGrid from "../../components/portfolio/MediaGrid.astro"
import { samplePortfolioProject } from "../../lib/sample-content"
import {
  fetchPortfolioProjectBySlug,
  fetchPortfolioProjects,
  isPortfolioAuthConfigured,
  isPortfolioConfigured,
} from "../../lib/server/portfolio"

export async function getStaticPaths() {
  const sampleEntry = {
    params: {
      slug: samplePortfolioProject.slug,
    },
    props: {
      project: samplePortfolioProject,
    },
  }

  if (!isPortfolioConfigured()) {
    return [sampleEntry]
  }

  try {
    const projects = await fetchPortfolioProjects()
    const entries = await Promise.all(
      projects.map(async (project) => ({
        slug: project.slug,
        project: await fetchPortfolioProjectBySlug(project.slug),
      }))
    )

    const staticEntries = entries
      .filter((entry) => entry.project)
      .map((entry) => ({
        params: {
          slug: entry.slug,
        },
        props: {
          project: entry.project,
        },
      }))
      .filter((entry) => entry.params.slug !== samplePortfolioProject.slug)
    return [sampleEntry, ...staticEntries]
  } catch (error) {
    console.error("Unable to generate static portfolio pages.", error)
    return [sampleEntry]
  }
}

const { project = null } = Astro.props
const hasAuth = isPortfolioAuthConfigured()
const isSampleProject = project?.slug === samplePortfolioProject.slug
const projectFacts = project
  ? [
      project.address ? { label: "Location", value: project.address } : null,
      project.size ? { label: "Project scale", value: project.size } : null,
      project.images.length > 0 ? { label: "Image gallery", value: `${project.images.length} images` } : null,
      project.videos.length > 0 ? { label: "Video library", value: `${project.videos.length} videos` } : null,
    ].filter(Boolean)
  : []
---

<Layout
  title={project ? `${project.title} | Portfolio` : "Portfolio | Eternal Concepts by Philip J. Rhea"}
  description={project?.shortDescription || "Portfolio project details for Eternal Concepts by Philip J. Rhea."}
>
  {
    !project ? (
      <section class="grid min-h-[70vh] place-items-center px-6 text-center text-stone-700">
        <div class="max-w-xl space-y-4">
          <p class="text-sm uppercase tracking-[0.4em] text-stone-400">Portfolio</p>
          <h1 class="text-4xl">Project not found</h1>
          <p class="leading-8 text-stone-500">
            This project does not exist yet or is not published in Strapi.
          </p>
          {
            !hasAuth ? (
              <p class="text-sm text-amber-800">
                If this content is not public in Strapi, add `STRAPI_API_TOKEN` to the Astro app.
              </p>
            ) : null
          }
          <a href="/portfolio" class="inline-flex border border-stone-300 px-6 py-3 text-sm uppercase tracking-[0.25em] text-stone-700">
            Back to portfolio
          </a>
        </div>
      </section>
    ) : (
      <>
        {
          isSampleProject ? (
            <section class="bg-amber-50 px-6 py-4 text-center text-sm text-amber-900">
              Sample portfolio page shown because local Strapi portfolio content is not available yet.
            </section>
          ) : null
        }
        <section class="relative isolate overflow-hidden bg-stone-900 text-white">
          {
            project.coverImage ? (
              <div class="absolute inset-0">
                <img
                  src={project.coverImage.largeUrl}
                  alt={project.coverImage.alt}
                  class="h-full w-full object-cover"
                  loading="eager"
                />
              </div>
            ) : (
              <div class="absolute inset-0 bg-[linear-gradient(135deg,#57534e_0%,#292524_48%,#0c0a09_100%)]"></div>
            )
          }
          <div class="absolute inset-0 bg-[linear-gradient(135deg,rgba(12,10,9,0.88)_0%,rgba(12,10,9,0.74)_42%,rgba(12,10,9,0.82)_100%)]"></div>
          <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(255,255,255,0.18),transparent_34%)]"></div>

          <div class="relative mx-auto flex min-h-[62vh] w-11/12 max-w-[1366px] flex-col justify-end py-14 sm:py-18 lg:min-h-[72vh] lg:py-24">
            <div class="max-w-5xl">
              <div class="text-[0.72rem] uppercase tracking-[0.32em] text-stone-300">
                <a href="/" class="transition hover:text-white">Home</a>
                <span class="px-2 text-stone-500">/</span>
                <a href="/portfolio" class="transition hover:text-white">Portfolio</a>
                <span class="px-2 text-stone-500">/</span>
                <span class="text-white">{project.title}</span>
              </div>

              <p class="mt-8 text-[0.72rem] uppercase tracking-[0.35em] text-stone-300">Project dossier</p>
              <h1 class="mt-4 max-w-4xl text-4xl leading-tight sm:text-5xl lg:text-7xl">{project.title}</h1>
              {project.address ? <p class="mt-5 text-2xl font-serif italic text-stone-200 sm:text-3xl lg:text-4xl">{project.address}</p> : null}
              {project.shortDescription ? (
                <p class="mt-6 max-w-3xl text-base leading-8 text-stone-200 sm:text-lg">
                  {project.shortDescription}
                </p>
              ) : null}

              {
                projectFacts.length > 0 ? (
                  <div class="mt-10 grid max-w-4xl grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-4">
                    {projectFacts.map((fact) => (
                      <div class="rounded-[1.4rem] border border-white/10 bg-white/7 px-5 py-5 backdrop-blur-sm">
                        <p class="text-[0.66rem] uppercase tracking-[0.3em] text-stone-300">{fact.label}</p>
                        <p class="mt-3 text-sm leading-6 text-white">{fact.value}</p>
                      </div>
                    ))}
                  </div>
                ) : null
              }
            </div>
          </div>
        </section>

        <section class="bg-stone-100 px-6 py-12 sm:px-10 lg:px-16 lg:py-18">
          <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[minmax(0,1.2fr)_minmax(320px,0.8fr)] lg:gap-14">
            <div class="space-y-6 text-stone-700">
              <div>
                <p class="text-sm uppercase tracking-[0.3em] text-stone-400">Overview</p>
                <h2 class="mt-3 text-3xl sm:text-4xl">Design narrative</h2>
              </div>

              {
                project.longDescription ? (
                  <div
                    class="max-w-none text-stone-700 [&_a]:text-stone-900 [&_a]:underline [&_li]:leading-8 [&_ol]:ml-6 [&_ol]:list-decimal [&_p]:text-lg [&_p]:leading-8 [&_ul]:ml-6 [&_ul]:list-disc [&_ul]:space-y-2 [&_p+*]:mt-6"
                    set:html={project.longDescription}
                  />
                ) : (
                  <p class="text-lg leading-8 text-stone-600">
                    Additional project narrative will appear here when a long description is available in Strapi.
                  </p>
                )
              }
            </div>

            <aside class="h-fit rounded-[2rem] border border-stone-300 bg-white p-6 shadow-sm sm:p-8">
              <p class="text-sm uppercase tracking-[0.3em] text-stone-400">Quick facts</p>
              <div class="mt-6 space-y-5 text-stone-700">
                {project.address ? (
                  <div>
                    <p class="text-[0.68rem] uppercase tracking-[0.25em] text-stone-400">Address</p>
                    <p class="mt-2 leading-7">{project.address}</p>
                  </div>
                ) : null}
                {project.size ? (
                  <div>
                    <p class="text-[0.68rem] uppercase tracking-[0.25em] text-stone-400">Scale</p>
                    <p class="mt-2 leading-7">{project.size}</p>
                  </div>
                ) : null}
                {project.folder?.name ? (
                  <div>
                    <p class="text-[0.68rem] uppercase tracking-[0.25em] text-stone-400">Media folder</p>
                    <p class="mt-2 leading-7">{project.folder.name}</p>
                  </div>
                ) : null}
                <div>
                  <p class="text-[0.68rem] uppercase tracking-[0.25em] text-stone-400">Assets</p>
                  <p class="mt-2 leading-7">
                    {project.images.length} images
                    {project.videos.length > 0 ? ` and ${project.videos.length} videos` : ""}
                  </p>
                </div>
              </div>

              <div class="mt-8 flex flex-col gap-3">
                <a
                  href="/portfolio"
                  class="inline-flex items-center justify-center rounded-full border border-stone-300 px-5 py-3 text-sm uppercase tracking-[0.22em] text-stone-700 transition hover:border-stone-900 hover:text-stone-950"
                >
                  Back to archive
                </a>
              </div>
            </aside>
          </div>
        </section>

        {
          project.videos.length > 0 || project.images.length > 0 ? (
            <section class="bg-white px-6 py-12 sm:px-10 lg:px-16 lg:py-16">
              <div class="mx-auto max-w-6xl">
                <div class="mb-8 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
                  <div>
                    <p class="text-sm uppercase tracking-[0.3em] text-stone-400">Project media</p>
                    <h2 class="mt-2 text-3xl sm:text-4xl">Gallery and supporting visuals</h2>
                  </div>
                  <p class="max-w-xl text-sm leading-7 text-stone-500">
                    Open any image in a new tab, or view supporting videos from the project page.
                  </p>
                </div>
                <MediaGrid videos={project.videos} images={project.images} projectTitle={project.title} />
              </div>
            </section>
          ) : null
        }
      </>
    )
  }
</Layout>
