---
import Layout from "../../components/layout/Layout.astro"
import MediaGrid from "../../components/portfolio/MediaGrid.astro"
import {
  fetchPortfolioProjectBySlug,
  getMapEmbedUrl,
  isPortfolioAuthConfigured,
  isPortfolioConfigured,
} from "../../lib/server/portfolio"

const slug = Astro.params.slug || ""
let project = null
let loadError = ""

if (isPortfolioConfigured() && slug) {
  try {
    project = await fetchPortfolioProjectBySlug(slug)
  } catch (error) {
    loadError = error instanceof Error ? error.message : "Unable to load this portfolio project."
  }
}

if (!loadError && isPortfolioConfigured() && slug && !project) {
  Astro.response.status = 404
}

const mapUrl = project ? getMapEmbedUrl(project.mapQuery) : null
const hasAuth = isPortfolioAuthConfigured()
---

<Layout
  title={project ? `${project.title} | Portfolio` : "Portfolio | Eternal Concepts by Philip J. Rhea"}
  description={project?.shortDescription || "Portfolio project details for Eternal Concepts by Philip J. Rhea."}
>
  {
    !isPortfolioConfigured() ? (
      <section class="grid min-h-[70vh] place-items-center px-6 text-center text-stone-700">
        <div class="max-w-xl rounded-2xl border border-amber-300 bg-amber-50 px-6 py-8">
          Add `STRAPI_URL` to load portfolio projects from Strapi.
        </div>
      </section>
    ) : loadError ? (
      <section class="grid min-h-[70vh] place-items-center px-6 text-center text-stone-700">
        <div class="max-w-xl rounded-2xl border border-amber-300 bg-amber-50 px-6 py-8">
          <p>{loadError}</p>
          {
            !hasAuth ? (
              <p class="mt-2 text-sm text-amber-800">
                If this content is not public in Strapi, add `STRAPI_API_TOKEN` to the Astro app.
              </p>
            ) : null
          }
        </div>
      </section>
    ) : !project ? (
      <section class="grid min-h-[70vh] place-items-center px-6 text-center text-stone-700">
        <div class="max-w-xl space-y-4">
          <p class="text-sm uppercase tracking-[0.4em] text-stone-400">Portfolio</p>
          <h1 class="text-4xl">Project not found</h1>
          <p class="leading-8 text-stone-500">
            This project does not exist yet or is not published in Strapi.
          </p>
          <a href="/portfolio" class="inline-flex border border-stone-300 px-6 py-3 text-sm uppercase tracking-[0.25em] text-stone-700">
            Back to portfolio
          </a>
        </div>
      </section>
    ) : (
      <>
        <div class="bg-stone-800 px-5 py-2 text-right text-[0.72rem] font-medium text-white/90 sm:px-8">
          <a href="/" class="hover:text-white">Home</a>
          <span> | </span>
          <a href="/portfolio" class="hover:text-white">Portfolio</a>
          <span> | </span>
          <span>{project.title}</span>
        </div>

        {
          project.coverImage ? (
            <div class="h-[38vh] min-h-[260px] w-full overflow-hidden bg-stone-300 sm:h-[44vh] lg:h-[52vh]">
              <img
                src={project.coverImage.largeUrl}
                alt={project.coverImage.alt}
                class="h-full w-full object-cover"
                loading="eager"
              />
            </div>
          ) : (
            <div class="h-[32vh] min-h-[220px] bg-[linear-gradient(135deg,#d6d3d1_0%,#78716c_45%,#1c1917_100%)]"></div>
          )
        }

        <section class="bg-stone-100 px-6 py-12 sm:px-10 lg:px-16 lg:py-16">
          <div class="mx-auto max-w-6xl">
            <div class="max-w-5xl space-y-5 text-stone-700">
              <h1 class="text-4xl sm:text-5xl lg:text-6xl">{project.title}</h1>

              {project.address ? <p class="text-2xl font-serif italic text-stone-500 sm:text-3xl">{project.address}</p> : null}
              {project.size ? <p class="text-lg uppercase tracking-[0.2em] text-stone-400 sm:text-xl">{project.size}</p> : null}
              {project.shortDescription ? <p class="max-w-5xl text-lg leading-9 text-stone-600">{project.shortDescription}</p> : null}

              {
                project.longDescription ? (
                  <div
                    class="max-w-none text-stone-700 [&_a]:text-stone-900 [&_a]:underline [&_li]:leading-8 [&_ol]:ml-6 [&_ol]:list-decimal [&_p]:text-lg [&_p]:leading-8 [&_ul]:ml-6 [&_ul]:list-disc [&_ul]:space-y-2 [&_p+*]:mt-6"
                    set:html={project.longDescription}
                  />
                ) : null
              }
            </div>
          </div>
        </section>

        {
          project.videos.length > 0 || project.images.length > 0 ? (
            <section class="bg-white px-6 py-10 sm:px-10 lg:px-16 lg:py-12">
              <div class="mx-auto max-w-6xl">
                <MediaGrid videos={project.videos} images={project.images} projectTitle={project.title} />
              </div>
            </section>
          ) : null
        }

        {
          mapUrl ? (
            <section class="bg-stone-50 px-6 py-12 sm:px-10 lg:px-16 lg:py-16">
              <div class="mx-auto max-w-6xl space-y-5">
                <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
                  <div>
                    <p class="text-sm uppercase tracking-[0.3em] text-stone-400">Project Map</p>
                    <h2 class="mt-2 text-3xl sm:text-4xl">Location context</h2>
                  </div>
                  <a
                    href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(project.mapQuery)}`}
                    target="_blank"
                    rel="noreferrer"
                    class="text-sm uppercase tracking-[0.2em] text-stone-700"
                  >
                    Open in Google Maps
                  </a>
                </div>

                <div class="overflow-hidden rounded-2xl border border-stone-300 shadow-sm">
                  <iframe
                    src={mapUrl}
                    title={`${project.title} map`}
                    class="h-[420px] w-full border-0"
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    allowfullscreen
                  ></iframe>
                </div>
              </div>
            </section>
          ) : null
        }
      </>
    )
  }
</Layout>
